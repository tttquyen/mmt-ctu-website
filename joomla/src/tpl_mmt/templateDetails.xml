		<language tag="en-GB">en-GB/tpl_mmt.sys.ini</language>
		<language tag="vi-VN">vi-VN/tpl_mmt.ini</language>
		<language tag="vi-VN">vi-VN/tpl_mmt.sys.ini</language>
	</languages>
